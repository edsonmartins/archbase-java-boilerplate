# ============================================
# ARCHBASE JAVA BOILERPLATE - ENV EXAMPLE
# ============================================

# Application
APP_PROFILE=dev
APP_PORT=8080
APP_CONTEXT_PATH=/

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=archbase_db
POSTGRES_USER=archbase
POSTGRES_PASSWORD=changeit

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Archbase Security
ARCHBASE_JWT_SECRET=generate-a-secure-random-secret-key-here
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8080

# OpenAPI/Swagger
SWAGGER_ENABLED=true
