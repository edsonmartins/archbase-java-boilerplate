<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.archbase.boilerplate</groupId>
        <artifactId>archbase-java-boilerplate</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>archbase-boilerplate-rest</artifactId>
    <packaging>jar</packaging>
    <name>Archbase Boilerplate REST</name>
    <description>Módulo REST com controllers e configurações web</description>

    <dependencies>
        <!-- Core Module -->
        <dependency>
            <groupId>br.com.archbase.boilerplate</groupId>
            <artifactId>archbase-boilerplate-core</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Jetty no lugar do Tomcat (Spring Boot 4 removeu o suporte a Undertow) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jetty</artifactId>
        </dependency>

        <!--
          O `spring-hateoas` entra transitivamente pelo Archbase, e o springdoc
          ativa a autoconfiguração de HATEOAS — que no Spring Boot 4 mora em
          módulo próprio. Sem este starter a aplicação não sobe:

            TypeNotPresentException: org.springframework.boot.hateoas.autoconfigure.HateoasProperties
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-hateoas</artifactId>
        </dependency>

        <!--
          Mesma história com o Data REST: vem transitivo pelo Archbase, que usa
          `RepositoryRestConfigurer`, e o springdoc exige a autoconfiguração.

          A estratégia de detecção fica em `annotated` no application.yml — o
          padrão publicaria CRUD HTTP para TODO repositório público, escrevendo
          entidade direto no banco por fora dos serviços.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-rest</artifactId>
        </dependency>

        <!--
          OBRIGATÓRIO com `server.http2.enabled: true` no application.yml.

          O `spring-boot-starter-jetty` NÃO traz o módulo HTTP/2, e o Jetty o exige
          para configurar h2c. Sem ele a aplicação morre no boot com
          NoClassDefFoundError: org/eclipse/jetty/http2/server/HTTP2CServerConnectionFactory
          — e o erro não menciona a dependência que falta.
        -->
        <dependency>
            <groupId>org.eclipse.jetty.http2</groupId>
            <artifactId>jetty-http2-server</artifactId>
        </dependency>

        <!-- Spring Boot Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- OpenAPI (swagger-annotations-jakarta vem transitivo do archbase 3.0.0) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot WebFlux (para WebClient) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Redis (Jedis) -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>

        <!-- Rate Limiting (Bucket4j) -->
        <dependency>
            <groupId>com.github.vladimir-bukhtoyarov</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>7.6.0</version>
        </dependency>

        <!-- H2 Database (para testes sem PostgreSQL) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Failsafe: sem ele, teste de integração terminado em `IT` NUNCA RODA.

              O Surefire só reconhece `*Test`. Um `*IT` sem este plugin passa
              despercebido e o build fica verde sem ter executado nada — a pior
              forma de falso positivo, porque a suíte parece cobrir e não cobre.

              `mvn test`   = o que não precisa de infraestrutura.
              `mvn verify` = acrescenta o que exige banco.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
