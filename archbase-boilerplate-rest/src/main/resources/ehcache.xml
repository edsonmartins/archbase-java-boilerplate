<?xml version="1.0" encoding="UTF-8"?>
<ehcache xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://www.ehcache.org/v3"
         xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core.xsd">

    <!-- Template de cache padrão -->
    <cache-template name="defaultCache">
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <resources>
            <heap>1000</heap>
            <offheap unit="MB">100</offheap>
        </resources>
    </cache-template>

    <!-- Cache para entidades com TTL de 8 horas -->
    <cache alias="entity-cache-8h">
        <expiry>
            <ttl unit="hours">8</ttl>
        </expiry>
        <resources>
            <heap>500</heap>
            <offheap unit="MB">100</offheap>
        </resources>
    </cache>

    <!-- Cache para entidades com TTL de 1 hora -->
    <cache alias="entity-cache-1h">
        <expiry>
            <ttl unit="hours">1</ttl>
        </expiry>
        <resources>
            <heap>500</heap>
            <offheap unit="MB">100</offheap>
        </resources>
    </cache>

    <!-- Cache para consultas frequentes -->
    <cache alias="query-cache">
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap>1000</heap>
            <offheap unit="MB">50</offheap>
        </resources>
    </cache>

</ehcache>
