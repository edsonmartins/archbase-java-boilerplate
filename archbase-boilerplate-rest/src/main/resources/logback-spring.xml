<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console Appender com cores -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{dd-MM-yyyy HH:mm:ss.SSS} %magenta([%thread]) %cyan([%X{correlationId:-}]) %highlight(%-5level) %logger{36}.%M - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- File Appender (opcional, descomente para usar) -->
    <!--
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/archbase-boilerplate.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/archbase-boilerplate.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{dd-MM-yyyy HH:mm:ss.SSS} [%thread] [%X{correlationId:-}] %-5level %logger{36}.%M - %msg%n</pattern>
        </encoder>
    </appender>
    -->

    <!-- Root Logger -->
    <root level="info">
        <appender-ref ref="STDOUT"/>
        <!-- <appender-ref ref="FILE"/> -->
    </root>

    <!-- Archbase Framework -->
    <logger name="br.com.archbase" level="info" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>

    <!-- Archbase Boilerplate -->
    <logger name="br.com.archbase.boilerplate" level="debug" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>

    <!-- Hibernate: reduzir logs de erro comuns -->
    <logger name="org.hibernate.collection.spi.AbstractPersistentCollection" level="error">
        <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="org.hibernate.mapping.RootClass" level="error">
        <appender-ref ref="STDOUT"/>
    </logger>

    <!-- Spring MVC: mapeamento de endpoints -->
    <logger name="org.springframework.web.servlet.mvc.method.annotation.RequestMappingHandlerMapping" level="debug" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>

    <!-- Descomente para ver SQL em desenvolvimento -->
    <!--
    <logger name="org.hibernate.SQL" level="debug" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="trace" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>
    -->

</configuration>
